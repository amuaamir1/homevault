rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedInAs(userId);

      match /feedback/{feedbackId} {
        allow create: if signedInAs(userId)
          && request.resource.data.uid == userId
          && request.resource.data.category in [
            'bug',
            'featureRequest',
            'performance',
            'authentication',
            'documents',
            'other'
          ]
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 10
          && request.resource.data.message.size() <= 5000
          && (
            request.resource.data.screenshotBase64 == null
            || (
              request.resource.data.screenshotBase64 is string
              && request.resource.data.screenshotBase64.size() <= 700000
            )
          );

        allow read, update, delete: if false;
      }
    }
  }
}
